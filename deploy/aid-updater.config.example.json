{
  "healthFile": "/var/lib/aid-updater/health.json",
  "taskFile": "/var/lib/aid-updater/inbox/task.json",
  "workDir": "/var/lib/aid-updater/work",
  "backupDir": "/var/lib/aid-updater/backups",
  "pollIntervalSeconds": 3,
  "heartbeatIntervalSeconds": 5,
  "downloadTimeoutSeconds": 600,
  "keepBackups": 3,
  "sourceBuildScript": "/data/aid/installer/deploy/build-release-from-source.sh",
  "sourceBuildTimeoutSeconds": 7200,
  "install": {
    "backendJar": "/data/aid/app/aid-admin.jar",
    "adminDist": "/data/aid/app/admin-dist",
    "webDist": "/data/aid/app/web-dist",
    "serviceManager": "systemd",
    "backendService": "aid",
    "restartServices": ["aid-web"],
    "healthCheckUrl": "http://127.0.0.1:8080",
    "healthCheckTimeoutSeconds": 180
  },
  "database": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 3306,
    "name": "aid",
    "user": "root",
    "password": "",
    "execContainer": ""
  },
  "deployment": {
    "descriptorFile": "/data/aid/config/deployment.json",
    "configPath": "/data/aid/aid-deploy.conf",
    "defaultConfigPath": "/data/aid/aid-deploy.conf",
    "allowedConfigRoot": "/data/aid/config",
    "composeFile": "/data/aid/installer/deploy/docker/docker-compose.yml",
    "managerScript": "/data/aid/installer/deploy/aid.sh"
  }
}

# ============================================================================
# AID 手动部署配置（唯一配置真源，systemd 部署方式专用）
#   首次部署必须先复制本模板到数据目录：
#     mkdir -p /data/aid
#     cp aid-deploy.conf.example /data/aid/aid-deploy.conf
#     vim /data/aid/aid-deploy.conf
#   之后所有配置调整都编辑 /data/aid/aid-deploy.conf（本模板保持原样）；
#   修改后执行 sudo bash aid.sh 菜单「重启服务」生效。
#
# 说明：
#   - DEPENDENCY_INSTALL_MODE=auto 时，固定工具链下载到隔离缓存，系统服务按需使用包管理器
#   - 源码构建使用校验后的 JDK 17、Node、Maven、Go 和 Git；版本符合时直接跳过
#   - 本机 MySQL/Redis 仅在地址为 127.0.0.1/localhost 且确实缺失时自动安装
#   - 外部 MySQL/Redis/RocketMQ 永远只连接和校验，不会在本机安装或覆盖
#   - RocketMQ 不自动安装；启用前必须准备可连接的外部 NameServer
#   - TOKEN_SECRET 留空 = 部署脚本自动生成强随机值写回本文件
#   - 密码不能包含 空格、#、引号、$、反斜杠（会破坏配置解析）
#   - 数据目录默认 /data/aid，如需更换：执行脚本前 export AID_DATA_ROOT=/你的路径
# ============================================================================

# ---------------- HTTP 端口（无需域名） ----------------
DATA_ROOT=/data/aid

# ---------------- 依赖处理 ----------------
# auto（默认）：JDK、Node、Maven、Go 固定版本下载到隔离缓存，其余系统工具按需安装；
# manual：只检查并打印缺失项，不安装软件。已有且版本合格的依赖两种模式都会跳过。
# 手动部署不会安装 Docker/RocketMQ；本机 MySQL5.7、Redis 缺失时按需安装。
DEPENDENCY_INSTALL_MODE=auto
# auto=按服务器公网出口地区自动选择；cn=国内镜像优先；global=官方地址优先。
DEPENDENCY_REGION=auto
# 服务器存在 Docker 时，源码构建容器使用这些 Docker Hub 国内代理；按测速结果依次尝试。
# 支持云厂商专属加速域名，多个地址用英文逗号分隔，不要填写账号或密码。
DOCKER_MIRRORS=docker.m.daocloud.io,dockerproxy.net
# 下载总时长上限（秒）；0=不限总时长，正整数（例如1500）=到时停止。
DOWNLOAD_TIMEOUT_SECONDS=0
# 用户端（C端）对外端口，由 Nginx 监听
HTTP_PORT=80
# 后台管理端对外端口；访问码由首次部署脚本随机生成并在完成后打印。
ADMIN_PORT=8089
# 后端 Java 服务本机端口
BACKEND_PORT=8080

# ---------------- HTTPS（可选） ----------------
# true=由脚本生成并校验 Nginx HTTPS 站点；false=仅保留 HTTP
# 没有域名或尚未完成 DNS 解析时保持 false；下列 HTTPS 字段会被完全忽略。
# 先在域名服务商把用户域名、管理域名的 A 记录都解析到服务器公网 IPv4；DNS 解析不会关闭 IP/HTTP 访问。
# 此时用户端使用 http://服务器IP，管理端使用 http://服务器IP:ADMIN_PORT。
HTTPS_ENABLED=false
HTTPS_PORT=443
HTTPS_PUBLIC_DOMAIN=www.example.com
HTTPS_ADMIN_DOMAIN=admin.example.com
# 证书必须放在 DATA_ROOT/config/ssl 下且不能使用软链接
HTTPS_CERT_PATH=/data/aid/config/ssl/fullchain.pem
HTTPS_KEY_PATH=/data/aid/config/ssl/privkey.pem

# ---------------- 数据库（固定使用 MySQL 5.7） ----------------
# DB_HOST=127.0.0.1 时 Navicat 推荐通过服务器 SSH 隧道连接，禁止直接向公网开放 3306。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aid
# 仅由脚本新建本机 MySQL 5.7 时使用；留空会生成强随机值，外部数据库忽略。
MYSQL_ROOT_PASSWORD=
# 新建本机数据库建议使用 aid；外部数据库填写已有且具备建库权限的账号。
DB_USERNAME=aid
# 本机新建时留空会生成；外部/已有数据库必须填写真实密码。
DB_PASSWORD=

# ---------------- Redis（本机可自动安装 6.x+，也支持外部） ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 6+ ACL 用户名；传统 requirepass 或无认证模式留空
REDIS_USERNAME=
# 留空表示无密码
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- 后端 ----------------
# JWT 令牌密钥（留空=部署脚本自动生成强随机值；泄露等于全部账号失守）
TOKEN_SECRET=
# 后端 JVM 参数（8G 内存服务器建议 -Xms2g -Xmx4g）
JAVA_OPTS=-Xms1g -Xmx2g

# ---------------- RocketMQ（可选，自备实例） ----------------
# false=本地任务模式（默认，功能完整，无需安装 MQ）；true=启用 MQ 派发
ROCKETMQ_ENABLED=false
# NameServer 地址（本机自装或另一台机器均可）
ROCKETMQ_NAMESERVER=127.0.0.1:9876
# 外部/自建 Broker 的刷盘模式由其服务端配置决定；本字段用于统一记录和后台展示。
ROCKETMQ_FLUSH_DISK_TYPE=ASYNC_FLUSH
# RocketMQ ACL AccessKey/SecretKey；未启用 ACL 时同时留空
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=

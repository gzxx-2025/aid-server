# ============================================================================
# AID Docker 部署配置（唯一配置真源）
#   首次部署由 aid.sh 自动复制本模板为 .env；高级用户也可提前复制并调整
#   之后所有配置调整都编辑 .env（本模板文件保持原样，升级时不会被覆盖）
# 密码/密钥类留空时部署脚本自动生成强随机值写回；
# 「生产调优」段默认值按 4核8G 服务器标定，按实际配置调节；
# 修改后执行 sudo bash aid.sh 菜单「重启服务」（或 docker compose up -d）生效。
# Docker 模式宿主机只要求预先安装 Docker Engine + Compose v2；
# Node/Go/Maven 使用构建容器；JDK 固定为校验后的 Temurin OpenJDK 17.0.20。
# ============================================================================

# 统一数据根目录：程序产物(app/)、上传文件、日志、MySQL/Redis/RocketMQ 数据全部在此目录下，
# 备份或迁移整个目录即可。在线升级时升级器替换 app/ 下的产物文件。
DATA_ROOT=/data/aid

# ---------------- 依赖处理 ----------------
# auto（默认）：缺失镜像与 OpenJDK 按地区线路下载；镜像必须匹配发布内置的官方摘要。
# manual：脚本不下载缺失镜像，只打印需要执行的 docker pull 命令后停止。
# Docker Engine 本身无论哪种模式都必须由管理员预先安装，脚本绝不自动安装。
DEPENDENCY_INSTALL_MODE=auto
# auto=按服务器公网出口地区自动选择；cn=国内镜像优先；global=官方地址优先。
DEPENDENCY_REGION=auto

# 站点对外端口（Nginx）：HTTP_PORT=C端用户端，ADMIN_PORT=后台管理端。
# 这两个端口与域名无关；没有域名时也必须保留，可直接通过服务器 IP 访问。
HTTP_PORT=80
# 后台登录访问码由首次部署脚本随机生成，完成后会打印完整地址。
ADMIN_PORT=8089

# ---------------- HTTPS（可选） ----------------
# 启用：COMPOSE_PROFILES 加入 https；不要把 HTTP_PORT 直接改成443，那不会启用TLS。
# 没有域名或尚未完成 DNS 解析：保持默认 Profile（不含 https），下列字段会被完全忽略。
# 用户端和管理端各使用一个域名，共用覆盖两个域名的SAN/通配符证书。
HTTPS_PORT=443
HTTPS_PUBLIC_DOMAIN=www.example.com
HTTPS_ADMIN_DOMAIN=admin.example.com
# 证书必须放在 DATA_ROOT/config/ssl 下，且不能是软链接；证书更新后执行 sudo aid restart。
HTTPS_CERT_PATH=/data/aid/config/ssl/fullchain.pem
HTTPS_KEY_PATH=/data/aid/config/ssl/privkey.pem

# ---------------- MySQL ----------------
# 默认使用内置 MySQL（COMPOSE_PROFILES 含 mysql）；外部 MySQL 时移除 mysql。
# 内置 MySQL root 密码（仅内置模式使用；留空由部署脚本生成强随机值）
MYSQL_ROOT_PASSWORD=
# 数据库地址。外部 MySQL 填内网 IP/DNS；Docker 宿主机可用 host.docker.internal。
DB_HOST=mysql
DB_PORT=3306
# 业务库名/账号；外部账号须有初始化、升级、备份和恢复所需权限。
DB_NAME=aid
DB_USERNAME=aid
# 内置模式留空自动生成；外部模式必须填写真实密码。
DB_PASSWORD=
# 内置 MySQL 的宿主机映射端口（外部模式不使用）
MYSQL_PORT=3306

# ---------------- Redis ----------------
# 默认使用内置 Redis 容器（COMPOSE_PROFILES 含 redis）；
# 使用外部 Redis：COMPOSE_PROFILES 去掉 redis，并把 REDIS_HOST/PORT 改为外部地址
REDIS_HOST=redis
REDIS_PORT=6379
# Redis 6+ ACL 用户名；传统 requirepass 或无认证模式留空
REDIS_USERNAME=
# 留空表示无密码；生产建议设置强密码
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- 后端 ----------------
# JWT 令牌密钥（留空=部署脚本自动生成强随机值；泄露等于全部账号失守）
TOKEN_SECRET=
# 后端在宿主机的映射端口（仅绑定 127.0.0.1，供运维排查）
BACKEND_PORT=8080

# ============================================================================
# 生产调优参数（可选，不设置则用默认值）
# ============================================================================

# 后端 JVM：8G 内存服务器建议 -Xms2g -Xmx4g；16G 建议 -Xms4g -Xmx8g
# 默认已带 G1GC 与 OOM 时自动转储堆快照到 logs 目录
#JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/aid/logs

# MySQL InnoDB 缓冲池：建议物理内存的 40%~50%（8G 服务器 → 2G；16G → 6G）
#MYSQL_BUFFER_POOL=2G
# MySQL 最大连接数
#MYSQL_MAX_CONNECTIONS=500

# Redis 内存上限：超限后按 REDIS_MAXMEMORY_POLICY 处理
#REDIS_MAXMEMORY=1gb
# 淘汰策略：默认 noeviction（本系统 Redis 承载分布式锁，禁止静默淘汰；写满报错可见）
#REDIS_MAXMEMORY_POLICY=noeviction

# 用户端 Node 运行参数（如提高 SSR 内存上限）
#WEB_NODE_OPTIONS=--max-old-space-size=1024

# ---------------- 组件开关（COMPOSE_PROFILES 控制内置容器的启停） ----------------
# mysql = 启动内置 MySQL 5.7；redis = 启动内置 Redis；mq = 启动内置 RocketMQ
# 组合示例：
#   COMPOSE_PROFILES=mysql,redis          内置 MySQL + Redis（默认）
#   COMPOSE_PROFILES=mysql,redis,mq       内置 MySQL + Redis + MQ
#   COMPOSE_PROFILES=mysql,redis,https    内置 MySQL + Redis + HTTPS
#   COMPOSE_PROFILES=https                外部 MySQL/Redis/MQ + HTTPS
#   COMPOSE_PROFILES=                     MySQL/Redis/MQ 全外部且不启用 Docker HTTPS
# 没有域名时使用不含 https 的组合，例如默认的 mysql,redis。
COMPOSE_PROFILES=mysql,redis

# ---------------- RocketMQ（可选组件） ----------------
# 后端是否加载 MQ 能力：false=本地任务模式（默认，功能完整）
ROCKETMQ_ENABLED=false
# NameServer 地址：内置容器用默认值；外部 MQ 改为 IP:9876
ROCKETMQ_NAMESERVER=rocketmq-nameserver:9876
# 内置 Broker 刷盘模式：ASYNC_FLUSH=异步刷盘（性能优先，默认）；
# SYNC_FLUSH=同步刷盘（持久性优先、写入延迟更高）。业务消息发送仍等待 Broker 确认。
ROCKETMQ_FLUSH_DISK_TYPE=ASYNC_FLUSH
# RocketMQ ACL AccessKey/SecretKey；未启用ACL时同时留空；内置与外部 MQ 均支持
# 凭证仅使用字母和数字。启用内置 MQ 时入口脚本会同步为 Broker 开启 ACL。
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
# NameServer JVM（很轻，默认 256m 足够）
#MQ_NAMESRV_JAVA_OPTS=-Xms256m -Xmx256m -Xmn128m
# Broker JVM：镜像默认 8G 大堆已被覆盖为 1G；消息量大时调到 -Xms2g -Xmx2g -Xmn1g 以上
#MQ_BROKER_JAVA_OPTS=-Xms2g -Xmx2g -Xmn1g
# 跨机使用本机 MQ：修改 rocketmq/broker.conf 的 brokerIP1 为本机IP，并为 broker 服务开放 10909/10911 端口

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:AIDSSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
server {
    listen 443 ssl;
    http2 on;
    server_name ${HTTPS_PUBLIC_DOMAIN};
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    include /etc/nginx/aid-managed/public.conf;
    location = /healthz { access_log off; return 200 "ok"; }
    location / {
        proxy_pass http://aid-web:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors on;
        error_page 404 = @aid_public_page;
    }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${HTTPS_ADMIN_DOMAIN};
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    include /etc/nginx/aid-managed/admin.conf;
    root /usr/share/nginx/aid/admin-dist;
    index index.html;
    location = /healthz { access_log off; return 200 "ok"; }
    location / { try_files $uri $uri/ /index.html; }
}

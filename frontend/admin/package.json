{
  "name": "aid-manager-react",
  "version": "1.0.0",
  "private": true,
  "description": "AID Manager - React + Ant Design 后台管理系统",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:stage": "vite build --mode staging",
    "typecheck": "tsc --noEmit",
    "test:capability": "node --experimental-strip-types scripts/capability-roundtrip.test.ts",
    "test:provider-callback": "node --experimental-strip-types scripts/provider-callback.test.ts",
    "test:provider-operations": "node --experimental-strip-types scripts/provider-operations.test.ts",
    "test:endpoint-path": "node --experimental-strip-types scripts/endpoint-path.test.ts",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,css}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^5.18.3",
    "axios": "^1.7.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.11",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.2.12",
    "js-cookie": "^3.0.5",
    "jsencrypt": "^3.3.2",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.9",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-glob": "^3.3.3",
    "less": "^4.2.0",
    "prettier": "^3.8.3",
    "typescript": "^5.5.2",
    "vite": "^5.3.2",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
